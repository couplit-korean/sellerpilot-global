{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "product", "design", "thumbnail", "localizedListings", "warnings"],
  "properties": {
    "mode": { "type": "string", "const": "cli" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "oneLine", "targetCustomer", "features", "cautions"],
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "oneLine": { "type": "string" },
        "targetCustomer": { "type": "string" },
        "features": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string" } },
        "cautions": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string" } }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeName", "palette", "heroCopy", "heroSubcopy", "cta", "sections"],
      "properties": {
        "themeName": { "type": "string" },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "accent", "surface", "text"],
          "properties": {
            "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "surface": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        },
        "heroCopy": { "type": "string" },
        "heroSubcopy": { "type": "string" },
        "cta": { "type": "string" },
        "sections": {
          "type": "array",
          "minItems": 5,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "eyebrow", "title", "body", "points"],
            "properties": {
              "type": { "type": "string", "enum": ["benefit", "story", "howto", "proof", "spec", "caution"] },
              "eyebrow": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "points": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "subline", "badge"],
      "properties": {
        "headline": { "type": "string" },
        "subline": { "type": "string" },
        "badge": { "type": "string" }
      }
    },
    "localizedListings": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "market", "locale", "title", "shortDescription", "description", "keywords", "thumbnailAltText", "detailSections"],
        "properties": {
          "channel": { "type": "string", "enum": ["qoo10", "shopee", "lazada", "coupang", "elevenst", "smartstore", "ebay", "temu"] },
          "market": { "type": "string", "enum": ["JP", "SG", "MY", "PH", "VN", "TH", "TW", "BR", "MX", "ID", "KR", "US", "GB", "DE", "AU", "CA", "FR", "IT", "ES"] },
          "locale": { "type": "string", "enum": ["ja-JP", "en-SG", "ms-MY", "en-PH", "vi-VN", "th-TH", "zh-TW", "pt-BR", "es-MX", "id-ID", "ko-KR", "en-US", "en-GB", "de-DE", "en-AU", "en-CA", "fr-FR", "it-IT", "es-ES"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "shortDescription": { "type": "string", "minLength": 1, "maxLength": 500 },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "keywords": { "type": "array", "minItems": 3, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
          "thumbnailAltText": { "type": "string", "minLength": 1, "maxLength": 180 },
          "detailSections": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "heading", "body", "imageAsset", "imageAltText"],
              "properties": {
                "type": { "type": "string", "enum": ["overview", "feature", "howto", "spec"] },
                "heading": { "type": "string", "minLength": 1, "maxLength": 100 },
                "body": { "type": "string", "minLength": 1, "maxLength": 500 },
                "imageAsset": { "type": "string", "enum": ["detail-overview", "detail-feature", "detail-use", "detail-package"] },
                "imageAltText": { "type": "string", "minLength": 1, "maxLength": 180 }
              }
            }
          }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 5, "items": { "type": "string" } }
  }
}
