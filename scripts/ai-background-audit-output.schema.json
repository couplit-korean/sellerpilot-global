{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "merchandisePresent",
    "packageOrContainerPresent",
    "labelBarcodeOrCertificationPresent",
    "humanPresent",
    "reservedZoneClear",
    "assignedEnvironmentPresent",
    "assignedLocationSatisfied",
    "assignedMomentSatisfied",
    "assignedSurfaceSatisfied",
    "assignedCameraSatisfied",
    "assignedPaletteSatisfied",
    "spatialDepthPresent",
    "observedLocationKey",
    "observedMomentKey",
    "observedSurfaceKey",
    "observedCameraKey",
    "observedPaletteKey",
    "observedSpatialDepthKey",
    "seriesVisuallyDistinct",
    "seriesLocationDistinct",
    "seriesMomentDistinct",
    "seriesSurfaceDistinct",
    "seriesPaletteDistinct",
    "seriesSpatialDepthDistinct",
    "seriesCameraDistinct",
    "seriesCueDistinct",
    "conflictingAssetIds",
    "assignedSupportingObjectsSatisfied",
    "observedNonMerchandiseProps",
    "confidence",
    "findings"
  ],
  "properties": {
    "merchandisePresent": { "type": "boolean" },
    "packageOrContainerPresent": { "type": "boolean" },
    "labelBarcodeOrCertificationPresent": { "type": "boolean" },
    "humanPresent": { "type": "boolean" },
    "reservedZoneClear": { "type": "boolean" },
    "assignedEnvironmentPresent": { "type": "boolean" },
    "assignedLocationSatisfied": { "type": "boolean" },
    "assignedMomentSatisfied": { "type": "boolean" },
    "assignedSurfaceSatisfied": { "type": "boolean" },
    "assignedCameraSatisfied": { "type": "boolean" },
    "assignedPaletteSatisfied": { "type": "boolean" },
    "spatialDepthPresent": { "type": "boolean" },
    "observedLocationKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "observedMomentKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "observedSurfaceKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "observedCameraKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "observedPaletteKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "observedSpatialDepthKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "seriesVisuallyDistinct": { "type": "boolean" },
    "seriesLocationDistinct": { "type": "boolean" },
    "seriesMomentDistinct": { "type": "boolean" },
    "seriesSurfaceDistinct": { "type": "boolean" },
    "seriesPaletteDistinct": { "type": "boolean" },
    "seriesSpatialDepthDistinct": { "type": "boolean" },
    "seriesCameraDistinct": { "type": "boolean" },
    "seriesCueDistinct": { "type": "boolean" },
    "conflictingAssetIds": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
    },
    "assignedSupportingObjectsSatisfied": { "type": "boolean" },
    "observedNonMerchandiseProps": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  }
}
