NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Server-only token used to claim SellerPilot AI jobs. Generate and store the
# real value in Vercel/Supabase secrets; never expose it through NEXT_PUBLIC_*.
SELLERPILOT_AI_WORKER_TOKEN=
# VERCEL_OIDC_TOKEN is injected automatically by Vercel at runtime. Do not set,
# copy, or persist it in local environment files.
NEXT_PUBLIC_SELLERPILOT_ENV=production

# Optional server-only Brave Web Search key for official-domain Shopee/Lazada/Temu competitor discovery.
# Never expose this value through NEXT_PUBLIC_*.
BRAVE_SEARCH_API_KEY=
