NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Vercel server-only AI Studio. Keep every value below out of NEXT_PUBLIC_*.
# Vercel injects the request-scoped OIDC token automatically; do not define or
# persist VERCEL_OIDC_TOKEN. AI_GATEWAY_API_KEY is an optional server fallback.
SELLERPILOT_AI_WORKER_TOKEN=
AI_GATEWAY_API_KEY=
SELLERPILOT_RELEASE_SHA=

# Supabase pg_cron/pg_net calls the internal Vercel routes with this secret.
# This does not configure Vercel Cron; vercel.json intentionally has no crons.
CRON_SECRET=

# Enable only channels whose Vercel Static IP, marketplace allowlist, database
# policy, and request attestation were verified together. Allowed names:
# coupang,smartstore,elevenst,temu
SELLERPILOT_SERVERLESS_STATIC_EGRESS_CHANNELS=

NEXT_PUBLIC_SELLERPILOT_ENV=production

# Optional read-only Vercel/Supabase Management API connections for the
# "서버 사용량" page. Missing values are shown as not configured, never zero.
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_ORGANIZATION_SLUG=

# Optional server-only same-product price providers. Commerce credentials may
# also come from the matching Supabase Vault record where the code supports it.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
ELEVENST_OPEN_API_KEY=
EBAY_BROWSE_CLIENT_ID=
EBAY_BROWSE_CLIENT_SECRET=
BRAVE_SEARCH_API_KEY=
